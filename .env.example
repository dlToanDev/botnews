# ============ Telegram ============
BOT_TOKEN=123456:ABC-YourTelegramBotToken

# ============ Database ============
POSTGRES_USER=botadmin
POSTGRES_PASSWORD=changeme_strong
POSTGRES_DB=botnews
# Trong Docker: host = "postgres". Khi chạy local ngoài Docker đổi thành "localhost".
DATABASE_URL=postgresql+asyncpg://botadmin:changeme_strong@postgres:5432/botnews

# ============ Redis / Celery ============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============ Web Admin ============
JWT_SECRET=super_secret_random_string_change_me
ADMIN_DEFAULT_USER=admin

# ============ Timezone ============
TIMEZONE=Asia/Ho_Chi_Minh

# ============ External APIs (Phase 3) ============
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
NEWSAPI_KEY=

# ============ Thanh toán SePay (bán gói trong bot) ============
# Điền đủ 4 dòng dưới để bật /muagoi. Lấy từ dashboard SePay (my.sepay.vn).
# Webhook trỏ về: https://<domain>/api/sepay/webhook (header Authorization: Apikey <key>)
SEPAY_WEBHOOK_APIKEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NAME=

# ============ Trợ lý AI (Google Gemini) ============
# Lấy key miễn phí tại Google AI Studio (aistudio.google.com) → Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
