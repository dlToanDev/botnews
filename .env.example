# ============ Telegram ============
BOT_TOKEN=123456:ABC-YourTelegramBotToken

# ============ Database ============
POSTGRES_USER=botadmin
POSTGRES_PASSWORD=changeme_strong
POSTGRES_DB=botnews
# Trong Docker: host = "postgres". Khi chạy local ngoài Docker đổi thành "localhost".
DATABASE_URL=postgresql+asyncpg://botadmin:changeme_strong@postgres:5432/botnews

# ============ Redis / Celery ============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============ Web Admin ============
JWT_SECRET=super_secret_random_string_change_me
ADMIN_DEFAULT_USER=admin

# ============ Timezone ============
TIMEZONE=Asia/Ho_Chi_Minh

# ============ External APIs (Phase 3) ============
API_FOOTBALL_KEY=
NEWSAPI_KEY=
